{
  "name": "browser-fingerprinting-privacy-lab",
  "version": "2.3.0",
  "private": true,
  "description": "Educational, local-only browser fingerprinting and privacy analysis lab (static SPA, no build step, no runtime dependencies).",
  "type": "module",
  "scripts": {
    "serve": "python3 scripts/serve.py 8765",
    "test": "node --test tests/unit/",
    "test:browser": "node scripts/cdp-driver.mjs \"$BROWSER\" http://localhost:8765 ./.test-output",
    "docs": "node scripts/generate-docs.mjs",
    "test:cross": "node scripts/pw-suite.mjs http://localhost:8765 ./.test-output/pw",
    "check-links": "node scripts/check-links.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^16.5.0",
    "playwright": "1.64.1"
  }
}
